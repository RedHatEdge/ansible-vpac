#!/bin/bash
# Managed by ansible-vpac / virtualization role — do not edit by hand.
# Regenerate: ansible-playbook site.yml --tags virt-qemu-hook
#
# libvirt qemu hook — for each VM whose name matches one of the patterns
# below, pin vhost-net and kvm-pit kernel threads to the same physical
# cores as the qemu emulator and raise them to SCHED_FIFO. Without this,
# vhost threads land on housekeeping cores at SCHED_OTHER and steal
# jitter from RT VMs even when vCPUs themselves are pinned.
#
# Empty pattern list = no-op (safe default for non-vendor VMs).

set -u

VM_NAME="${1:-}"
EVENT="${2:-}"

PATTERNS=(
{% for p in virtualization_qemu_hook_vm_patterns %}
    "{{ p }}"
{% endfor %}
)

VHOST_PRIO={{ virtualization_qemu_hook_vhost_priority }}
KVM_PIT_PRIO={{ virtualization_qemu_hook_kvm_pit_priority }}

# Only act on the "started" event after the VM is up.
[[ "$EVENT" == "started" ]] || exit 0

# Match VM name against patterns; exit silently if no match.
match=0
for p in "${PATTERNS[@]}"; do
    if [[ -n "$p" && "$VM_NAME" == $p ]]; then
        match=1
        break
    fi
done
[[ $match -eq 1 ]] || exit 0

# A VM start (re)creates macvtaps, which can re-spread kernel-managed NIC
# IRQs across all CPUs — including isolated RT cores. Re-assert the RT IRQ
# pinning before pinning the VM's own threads. No-op on hosts without an
# RT IRQ interface list (the unit gates on its conf file).
systemctl restart vpac-pin-irqs.service 2>/dev/null || true

# Wait for the qemu PID and its vhost threads instead of probing once:
# vhost kernel threads spawn when the NICs activate, which races the
# "started" event. The vendor's own hook waits ~10s for each — verified
# from a licensed vendor-built host — and without the wait this hook
# silently pinned nothing on slow starts. Divergence from the vendor
# hook, on purpose: theirs exits 1 on timeout (libvirt then kills the
# domain); ours logs loudly to the journal and lets the VM run unpinned —
# a running-but-unpinned relay beats a killed one, and stage 90 catches
# the pinning gap.
qemu_pid=""
for _ in $(seq 1 10); do
    qemu_pid=$(pgrep -f "guest=${VM_NAME}," | head -1)
    [[ -n "$qemu_pid" ]] && break
    sleep 1
done
if [[ -z "$qemu_pid" ]]; then
    logger -t vpac-qemu-hook "WARNING: ${VM_NAME}: no qemu process within 10s — vhost/kvm-pit threads NOT pinned"
    exit 0
fi

# Read the emulator pin (CPU set) for this VM via virsh.
emulator_cpus=$(virsh emulatorpin "$VM_NAME" 2>/dev/null | awk '/^[[:space:]]*\*:/ {print $2}')
if [[ -z "$emulator_cpus" ]]; then
    logger -t vpac-qemu-hook "WARNING: ${VM_NAME}: no emulatorpin readable — vhost/kvm-pit threads NOT pinned"
    exit 0
fi

vhost_tids=""
for _ in $(seq 1 10); do
    vhost_tids=$(pgrep -P 2 -f "vhost-${qemu_pid}")
    [[ -n "$vhost_tids" ]] && break
    sleep 1
done
if [[ -z "$vhost_tids" ]]; then
    logger -t vpac-qemu-hook "WARNING: ${VM_NAME}: no vhost-${qemu_pid} threads within 10s — check virtio NIC config"
fi

# Pin all vhost-${qemu_pid} kernel threads to the emulator core set + chrt FIFO.
pinned=0
for tid in $vhost_tids; do
    taskset -pc "$emulator_cpus" "$tid" >/dev/null 2>&1 || true
    chrt -fp "$VHOST_PRIO" "$tid"        >/dev/null 2>&1 || true
    pinned=$((pinned+1))
done

# Same for kvm-pit/${qemu_pid} threads.
for tid in $(pgrep -P 2 -f "kvm-pit/${qemu_pid}"); do
    taskset -pc "$emulator_cpus" "$tid" >/dev/null 2>&1 || true
    chrt -fp "$KVM_PIT_PRIO" "$tid"     >/dev/null 2>&1 || true
    pinned=$((pinned+1))
done

logger -t vpac-qemu-hook "${VM_NAME}: pinned ${pinned} vhost/kvm-pit thread(s) to cpus ${emulator_cpus} (qemu ${qemu_pid})"

exit 0
